Cell[CellGroupData[{

Cell["Envelope Function", "Subsubsection",
 CellChangeTimes->{{4.000418740200388*^9, 
  4.0004187556231613`*^9}},ExpressionUUID->"126a2c3b-0877-5349-92c9-\
a7a2c18678b9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"envZ", "[", "z_", "]"}], ":=", 
   RowBox[{"1", "+", 
    RowBox[{"1.84", "z"}]}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "Supoiendo", " ", "algun", " ", "ajuste", " ", "lineal", " ", "en", " ", 
    "la", " ", "envolvente"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol1", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"heqz", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"q", "->", "1"}], ",", 
          RowBox[{"m", "->", "10"}]}], "}"}]}], ",", "Cond"}], "}"}], ",", 
     "h", ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0", ",", "1"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol2", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"heqz", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"q", "->", "1"}], ",", 
          RowBox[{"m", "->", "100"}]}], "}"}]}], ",", "Cond"}], "}"}], ",", 
     "h", ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0", ",", "1"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pltSols", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"sol1", "[", "z", "]"}], ",", 
       RowBox[{"sol2", "[", "z", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0", ",", "1"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pltEnv", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"envZ", "[", "z", "]"}], ",", 
       RowBox[{"-", 
        RowBox[{"envZ", "[", "z", "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Directive", "[", 
         RowBox[{"Gray", ",", 
          RowBox[{"Thickness", "[", "0.003", "]"}]}], "]"}], ",", 
        RowBox[{"Directive", "[", 
         RowBox[{"Gray", ",", 
          RowBox[{"Thickness", "[", "0.003", "]"}]}], "]"}]}], "}"}]}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"pltSols", ",", "pltEnv"}], "}"}], ",", 
   RowBox[{"Frame", "->", "True"}]}], "]"}]}], "Input",
