Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Ahora", " ", "si"}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"a", " ", "resolver", " ", "la", " ", 
       RowBox[{"Ec", ".", " ", "de"}], " ", "Klein", " ", "Gordon", " ", 
       RowBox[{"\[Square]", "h"}]}], "-", "mh"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"0", " ", 
        RowBox[{"h", "''"}], 
        RowBox[{"(", "t", ")"}]}], "+", 
       RowBox[{"3", 
        RowBox[{"H0\:200bh", "'"}], 
        RowBox[{"(", "t", ")"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "2"}], "H0\:200bt"}], "]"}], 
           RowBox[{"k", "^", "2"}], "\:200b"}], "+", 
          RowBox[{"m", "^", "2"}]}], ")"}], "h", 
        RowBox[{"(", "t", ")"}]}]}], "=", "0"}]}], ",", " ", 
    RowBox[{
     RowBox[{"con", " ", "h", 
      RowBox[{"(", 
       RowBox[{"t", ",", "z"}], ")"}]}], "=", 
     RowBox[{
      RowBox[{"hk\:200b", 
       RowBox[{"(", "t", ")"}], 
       RowBox[{"Exp", "[", "ikz", "]"}], "\[IndentingNewLine]", "y", " ", 
       RowBox[{"\[Square]", "h"}]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"g", "[", 
         RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], 
        RowBox[{"Nabla", "[", 
         RowBox[{"-", "\[Mu]"}], "]"}], 
        RowBox[{"Nabla", "[", 
         RowBox[{"-", "\[Nu]"}], "]"}], "h"}], "=", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"-", "g"}], "]"}]], " ", 
        RowBox[{"\[PartialD]", 
         RowBox[{"[", "\[Mu]", "]"}]}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"-", "g"}], "]"}], 
          RowBox[{"g", "[", 
           RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], 
          RowBox[{"\[PartialD]", 
           RowBox[{"[", 
            RowBox[{"-", "\[Nu]"}], "]"}]}], "h"}], ")"}]}]}]}]}]}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"fValues", "=", 
     RowBox[{"{", 
      RowBox[{"0.01", ",", "0.1", ",", "1", ",", "10"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"H0val", "=", 
     RowBox[{"{", 
      RowBox[{"67", ",", "74"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kval", "=", "1"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Sols", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"mval", "=", 
         RowBox[{
          RowBox[{"m", "[", 
           RowBox[{"H0", ",", 
            RowBox[{"H0", "^", "4"}], ",", "f"}], "]"}], "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"H0", "->", 
             RowBox[{"H0val", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], ",", 
            RowBox[{"f", "->", "fval"}]}], "}"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"eqKG", "=", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"h", "''"}], "[", "t", "]"}], "+", 
           RowBox[{"3", " ", 
            RowBox[{"H0val", "[", 
             RowBox[{"[", "j", "]"}], "]"}], " ", 
            RowBox[{
             RowBox[{"h", "'"}], "[", "t", "]"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Exp", "[", 
                RowBox[{
                 RowBox[{"-", "2"}], " ", 
                 RowBox[{"H0val", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], " ", "t"}], "]"}], " ", 
               RowBox[{"kval", "^", "2"}]}], "+", "mval"}], ")"}], " ", 
            RowBox[{"h", "[", "t", "]"}]}]}], "==", "0"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"NDSolveValue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"eqKG", ",", 
            RowBox[{
             RowBox[{"h", "[", "0", "]"}], "==", "1"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"h", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
          "h", ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "5"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"fval", ",", "fValues"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "2"}], "}"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
