Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"DefScalarFunction", "[", "f1", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"DefScalarFunction", "[", "f2", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DefConstantSymbol", "[", "Rbar", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DefConstantSymbol", "[", "\[Kappa]", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DefTensor", "[", 
     RowBox[{
      RowBox[{"rho", "[", "]"}], ",", "M4", ",", 
      RowBox[{"PrintAs", "->", "\"\<\[Rho]\>\""}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"lm", "[", "]"}], ":=", 
     RowBox[{"-", 
      RowBox[{"rho", "[", "]"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Tal", " ", "cual"}], ",", " ", 
     RowBox[{"Lm", "=", 
      RowBox[{"-", "rho"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DefTensorPerturbation", "[", 
     RowBox[{
      RowBox[{"deltarho", "[", 
