Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Rbar", "=", 
    RowBox[{"12", " ", 
     RowBox[{"H0", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"\[Rho]\[CapitalLambda]", " ", "with", " ", "\[Beta]"}], "->", 
    "1"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"rhoSol", "=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"432", " ", 
       SuperscriptBox["\[ExponentialE]", 
        FractionBox[
         RowBox[{"f", " ", "\[Beta]"}], 
         RowBox[{"144", " ", 
          SuperscriptBox["H0", "4"]}]]], " ", 
       SuperscriptBox["H0", "6"], " ", "k"}], 
      RowBox[{
       RowBox[{"144", " ", 
        SuperscriptBox["H0", "4"]}], "-", "f", " "}]], "/.", 
     RowBox[{"\[Beta]", "->", "1"}]}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MassPaper", "=", 
   RowBox[{
    RowBox[{"-", "Rbar"}], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"x", "^", "2"}]}], "-", 
       RowBox[{"5", " ", "x"}], "+", "1"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"3", " ", "x", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", "x"}], "-", "3"}], ")"}]}], ")"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"MassPaperSub", "=", 
   RowBox[{
    RowBox[{"MassPaper", "/.", " ", 
     RowBox[{"x", "->", 
      RowBox[{"f", "/", 
       RowBox[{"Rbar", "^", "2"}]}]}]}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MasaMine", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"-", "\[Kappa]"}], "+", 
        RowBox[{"2", " ", "\[Rho]", " ", 
         RowBox[{
          SuperscriptBox["f2", "\[Prime]",
           MultilineFunction->None], "[", "Rbar", "]"}]}], "-", 
        RowBox[{"2", " ", "Rbar", " ", "\[Rho]", " ", 
         RowBox[{
          SuperscriptBox["f2", "\[Prime]\[Prime]",
           MultilineFunction->None], "[", "Rbar", "]"}]}]}], 
       RowBox[{"6", " ", "\[Rho]", " ", 
        RowBox[{
         SuperscriptBox["f2", "\[Prime]\[Prime]",
          MultilineFunction->None], "[", "Rbar", "]"}]}]], "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"f2", "->", 
         RowBox[{"Function", "[", 
          RowBox[{"R", ",", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "f"}], "/", 
             RowBox[{"R", "^", "2"}]}], "]"}]}], "]"}]}], ",", 
        RowBox[{"\[Rho]", "->", "rhoSol"}]}], "}"}]}], "/.", 
     RowBox[{"\[Kappa]", "->", "k"}]}], "//", "FullSimplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Masa \[Delta]R:\>\"", ",", " ", "MassPaperSub"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Masa obtenida por g->g+h:\>\"", ",", " ", "MasaMine"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Diferencia:\>\"", ",", 
   RowBox[{"MassPaperSub", "-", "MasaMine"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.997987536226898*^9, 3.997987536227402*^9}, {
