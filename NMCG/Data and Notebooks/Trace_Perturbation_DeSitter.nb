 CellLabel->"In[1]:=",ExpressionUUID->"6df2477c-ab69-c444-b73a-ca6288ec0b05"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "4"], " ", "\[Pi]", " ", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"1", "+", "z"}], ")"}], 
   RowBox[{"3", "/", "2"}]], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"3", "+", 
            SqrtBox[
             RowBox[{"9", "-", 
              RowBox[{"4", " ", 
               SuperscriptBox["m", "2"]}]}]]}], ")"}], " ", 
          RowBox[{"BesselJ", "[", 
           RowBox[{
            RowBox[{
             FractionBox["1", "2"], " ", 
             SqrtBox[
              RowBox[{"9", "-", 
               RowBox[{"4", " ", 
                SuperscriptBox["m", "2"]}]}]]}], ",", "q"}], "]"}]}], ")"}]}],
        "+", 
       RowBox[{"2", " ", "q", " ", 
        RowBox[{"BesselJ", "[", 
         RowBox[{
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"2", "+", 
             SqrtBox[
              RowBox[{"9", "-", 
               RowBox[{"4", " ", 
                SuperscriptBox["m", "2"]}]}]]}], ")"}]}], ",", "q"}], 
         "]"}]}]}], ")"}], " ", 
     RowBox[{"BesselY", "[", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], " ", 
        SqrtBox[
         RowBox[{"9", "-", 
          RowBox[{"4", " ", 
           SuperscriptBox["m", "2"]}]}]]}], ",", 
       RowBox[{"q", "+", 
        RowBox[{"q", " ", "z"}]}]}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"BesselJ", "[", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], " ", 
        SqrtBox[
         RowBox[{"9", "-", 
          RowBox[{"4", " ", 
           SuperscriptBox["m", "2"]}]}]]}], ",", 
       RowBox[{"q", "+", 
        RowBox[{"q", " ", "z"}]}]}], "]"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"3", "+", 
          SqrtBox[
           RowBox[{"9", "-", 
            RowBox[{"4", " ", 
             SuperscriptBox["m", "2"]}]}]]}], ")"}], " ", 
        RowBox[{"BesselY", "[", 
         RowBox[{
          RowBox[{
           FractionBox["1", "2"], " ", 
           SqrtBox[
            RowBox[{"9", "-", 
             RowBox[{"4", " ", 
              SuperscriptBox["m", "2"]}]}]]}], ",", "q"}], "]"}]}], "-", 
       RowBox[{"2", " ", "q", " ", 
        RowBox[{"BesselY", "[", 
         RowBox[{
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"2", "+", 
             SqrtBox[
              RowBox[{"9", "-", 
               RowBox[{"4", " ", 
                SuperscriptBox["m", "2"]}]}]]}], ")"}]}], ",", "q"}], 
         "]"}]}]}], ")"}]}]}], ")"}]}]], "Output",
 CellChangeTimes->{3.9990828508359375`*^9, 3.999679121596739*^9, 
  3.9996948528320217`*^9},
