Cell[CellGroupData[{

Cell["scalaron in z-terms", "Subsubsection",
 CellChangeTimes->{{3.9990787849642463`*^9, 
  3.999078796597988*^9}},ExpressionUUID->"cc2d35ad-38a3-6249-a552-\
989d77f8d261"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "where", " ", "q", " ", "and", " ", "m", " ", "are", " ", 
     "adimensional"}], ",", " ", 
    RowBox[{"divided", " ", "by", " ", "H0"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"heqz", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", "z"}], ")"}], "^", "2"}], " ", 
        RowBox[{
         RowBox[{"h", "''"}], "[", "z", "]"}]}], "-", 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "z"}], ")"}], " ", 
        RowBox[{
         RowBox[{"h", "'"}], "[", "z", "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"q", "^", "2"}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "+", "z"}], ")"}], "^", "2"}]}], "+", 
           RowBox[{"m", "^", "2"}]}], ")"}], ")"}], " ", 
        RowBox[{"h", "[", "z", "]"}]}]}], "==", "0"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Initial", " ", "conditions"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Cond", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"h", "[", "0", "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"h", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"hSol", "=", 
     RowBox[{"DSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"heqz", ",", 
         RowBox[{
          RowBox[{"h", "[", "0", "]"}], "==", "1"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"h", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
       RowBox[{"h", "[", "z", "]"}], ",", "z"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"hSolz", "[", 
      RowBox[{"qval_", ",", "mval_", ",", "zval_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"hSol", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"q", "->", "qval"}], ",", 
        RowBox[{"m", "->", "mval"}], ",", 
        RowBox[{"z", "->", "zval"}]}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mvals", "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"4", " ", 
           RowBox[{"(", 
            RowBox[{"10368", "-", 
             RowBox[{"360", " ", "f"}], "+", 
             RowBox[{"f", "^", "2"}]}], ")"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "216"}], "+", "f"}], ")"}], " ", "f"}], ")"}]}], 
        ")"}]}], "/.", " ", 
      RowBox[{"f", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "100"}], ",", 
         RowBox[{"1", "/", "10"}], ",", "1", ",", "10"}], "}"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hSolz", "[", 
     RowBox[{"q", ",", "m", ",", "z"}], "]"}], "//", "FullSimplify"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9990788182058525`*^9, 3.99907882818082*^9}, {
   3.999078896165424*^9, 3.9990789619492435`*^9}, {3.9990789928714905`*^9, 
   3.999079011497841*^9}, {3.999079050945846*^9, 3.999079069276331*^9}, {
   3.999079104377672*^9, 3.9990791721391125`*^9}, {3.999079210295519*^9, 
   3.999079262574198*^9}, 3.999079394113466*^9, {3.999079595005207*^9, 
   3.9990795994705544`*^9}, {3.9990796660868263`*^9, 3.999079668910984*^9}, {
   3.999079699316139*^9, 3.999079706859764*^9}, {3.999081070991682*^9, 
