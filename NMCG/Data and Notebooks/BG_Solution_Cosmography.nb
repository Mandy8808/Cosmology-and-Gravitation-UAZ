Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Soluciones", " ", "de", " ", "la", " ", "malla"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"SLSpointsOmegaf", "=", 
     RowBox[{"SolLabelSLS", "/.", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"q_", ",", "j_", ",", "sols_List"}], "}"}], ":>", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\[CapitalOmega]m", ",", "\[CapitalOmega]\[CapitalLambda]", ",", 
           "f"}], "}"}], "/.", " ", 
         RowBox[{"Select", "[", 
          RowBox[{"sols", ",", 
           RowBox[{
            RowBox[{"AllTrue", "[", 
             RowBox[{
              RowBox[{"Values", "[", "#", "]"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Im", "[", "#", "]"}], "==", "0"}], "&"}]}], "]"}], 
            "&"}]}], "]"}]}], ")"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SLSpointsOmegaf", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"SLSpointsOmegaf", ",", "2"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
