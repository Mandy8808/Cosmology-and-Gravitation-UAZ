        RowBox[{"0.38", "<=", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "<=", "0.67"}], "&"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", "Gr\[AAcute]fica", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"ListContourPlot", "[", 
    RowBox[{"pointsSLSFiltered", ",", 
     RowBox[{"Contours", "->", "15"}], ",", 
